# PowerContext 1.2.0 server settings for the demo.
# Copy to powercontext.env and replace the absolute path in DATABASE_URL.
# Note the four slashes: sqlite+aiosqlite:////<absolute-path>
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/powercontext.db
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=18080
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_MCP_ENABLED=false
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO
