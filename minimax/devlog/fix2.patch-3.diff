+from shop.models import Order, MEMBER_LEVELS
+from shop.pricing import total_cents
 
 def filter_orders(
     orders: list[Order],
@@ -16,5 +16,38 @@
     member_levels: set[str] | None = None,
     exclude_ids: set[str] | None = None,
 ) -> list[Order]:
-    """按状态、应付金额下限、会员等级筛选订单，保持输入顺序。"""
-    return list(orders)
+    """按状态、应付金额下限、会员等级与排除名单筛选订单，保持输入顺序。"""
+    if statuses is not None:
+        invalid_statuses = statuses - {status.value for status in Order.Status}
+        if invalid_statuses:
+            raise ValueError(f"Invalid statuses: {invalid_statuses}")
+    if member_levels is not None:
+        invalid_levels = member_levels - MEMBER_LEVELS
+        if invalid_levels:
+            raise ValueError(f"Invalid member levels: {invalid_levels}")
+    
+    if not orders:
+        return []
+    
+    if statuses is not None and not statuses:
+        return []
+    if member_levels is not None and not member_levels:
+        return []
