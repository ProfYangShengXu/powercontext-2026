 """订单筛选。

 目标行为见 corpus/specs/S-02-filtering.md；本文件当前是尚未实现的占位实现。
+from shop.pricing import total_cents

 from __future__ import annotations

 from shop.models import Order
@@ -11,6 +12,21 @@ def filter_orders(
     orders: list[Order],
     *,
     statuses: set[str] | None = None,
+    min_total_cents: int | None = None,
+    member_levels: set[str] | None = None,
+    exclude_ids: set[str] | None = None,
+ ) -> list[Order]:
+    """按状态、应付金额下限、会员等级筛选订单，保持输入顺序。"""
+    if statuses is not None and not isinstance(statuses, set):
+        raise ValueError("statuses must be a set of strings or None")
+    if member_levels is not None and not isinstance(member_levels, set):
+        raise ValueError("member_levels must be a set of strings or None")
+    if exclude_ids is not None and not isinstance(exclude_ids, set):
+        raise ValueError("exclude_ids must be a set of strings or None")
+
+    result = []
+    for order in orders:
+        if statuses is not None and order.status not in statuses:
+            continue
+        if min_total_cents is not None and total_cents(order) < min_total_cents:
+            continue
+        if member_levels is not None and order.member_level not in member_levels:
+            continue
+        if exclude_ids is not None and order.order_id in exclude_ids:
+            continue
+        result.append(order)
+    return result