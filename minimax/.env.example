# mmctx 运行时配置模板。复制成 .env 后按需修改；.env 不进版本库。
#
# 嵌入式 seekdb 的数据目录必须是本地 Linux 文件系统：
#   - WSL2 下 /mnt/d 是 Windows 盘的 9p 挂载，seekdb 打不开，请用 /mnt/wsl；
#   - 原生 Linux 可用 /var/tmp/mmctx-seekdb。
MMCTX_SEEKDB_PATH=/mnt/wsl/mmctx-seekdb

# PowerContext Server（Basic Memory 模式，不需要模型 API）
PC_SERVER_URL=http://127.0.0.1:8000
PC_SCOPE_TITLE=mmctx-competition
# 留空表示按标题自动查找/创建 Scope；也可以显式指定。
PC_SCOPE_ID=
PC_TIMEOUT_S=15

# MiniMax 国内站 chatcompletion_v2（实测可用，2026-10-31）。
# 不填 key 则 run 直接以退出码 4 失败，不会伪造结果。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_CHAT_PATH=/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_TIMEOUT_S=60
# thinking token 计入上限，给小了会得到空 content；Text-01 单次输出建议 ≤8192。
MINIMAX_MAX_COMPLETION_TOKENS=8192

# 上下文包 token 预算
MMCTX_BUDGET_TOKENS=12000
